{
	"license": ".license.template",
	"licenseFormats": {
		"js|ts": {
			"eachLine": {
				"prepend": "// "
			}
		}
	},
	"ignoreFile": ".gitignore",
	"ignore": [
		".github/**/*",
		".husky/**/*",
		"commitlint.config.cjs",
		"docs/**/*",
		"LICENSE",
		".license.template",
		"**/.gitignore",
		"**/.npmrc",
		"**/*.fuzz.js",
		"**/*.bench.js",
		"**/*.test.js",
		"**/*.e2e.js",
		"**/*.tst.ts",
		"**/*.md",
		"**/*.yml",
		"**/*.yaml",
		"**/*.css",
		"**/*.svelte",
		"**/*.json",
		"**/*.html",
		"websites/**/*",
		".DS_Store"
	]
}
