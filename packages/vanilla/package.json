{
	"name": "@willfarrell-ds/vanilla",
	"version": "0.0.0-beta.1",
	"type": "module",
	"description": "Design system using vanilla html, css, js",
	"files": [
		"all.css",
		"theme.css",
		"print.css",
		"index.tokens.json",
		"README.md",
		"bootstrap/",
		"classes/",
		"components/",
		"elements/",
		"layers/",
		"media/",
		"!**/*.test.js",
		"!**/*.e2e.js"
	],
	"exports": {
		"./all.css": "./all.css",
		"./theme.css": "./theme.css",
		"./print.css": "./print.css",
		"./index.tokens.json": "./index.tokens.json",
		"./bootstrap/*.js": "./bootstrap/*.js",
		"./classes/*.css": "./classes/*.css",
		"./components/*": "./components/*",
		"./elements/*.css": "./elements/*.css",
		"./layers/*.css": "./layers/*.css",
		"./media/*.css": "./media/*.css"
	},
	"scripts": {
		"test": "node --test --experimental-test-module-mocks '**/*.test.js'",
		"test:e2e": "node --test '**/*.e2e.js'"
	},
	"repository": {
		"type": "git",
		"url": "git+https://willfarrell@github.com/willfarrell/design-system.git"
	},
	"author": "willfarrell",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/willfarrell/design-system/issues"
	},
	"homepage": "https://github.com/willfarrell/design-system#readme",
	"dependencies": {
		"@simplewebauthn/browser": "14.0.0",
		"@ungap/custom-elements": "1.3.0",
		"prismjs": "1.30.0",
		"tinykeys": "4.0.1"
	},
	"devDependencies": {
		"playwright": "1.64.0"
	}
}
