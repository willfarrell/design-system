{
	"fontFamily": {
		"$description": "",
		"$type": "fontFamily",
		"$value": ["system-ui", "sans-serif"]
	},
	"fontSize": {
		"$description": "",
		"$type": "dimension",
		"$value": { "value": 100, "unit": "%" }
	},
	"lineHeight": {
		"$description": "",
		"$type": "dimension"
	},
	"letterSpacing": {
		"$description": "",
		"$type": "dimension"
	},
	"primaryColor": {
		"$type": "color",
		"$value": {
			"colorSpace": "hsl",
			"components": [260, 54, 39.22],
			"hex": "#6a4ab7"
		}
	},
	"secondaryColor": {
		"$type": "color",
		"$value": {
			"colorSpace": "hsl",
			"components": [260, 54, 39.22],
			"hex": "#6a4ab7"
		}
	},
	"fontColor": {
		"$description": "Body text color",
		"$type": "color",
		"$value": {
			"colorSpace": "srgb",
			"components": [0, 0, 0],
			"hex": "#000000"
		}
	},
	"backgroundColor": {
		"$description": "Body ",
		"$type": "color",
		"$value": {
			"colorSpace": "srgb",
			"components": [1, 1, 1],
			"hex": "#ffffff"
		}
	},
	"border": {
		"$type": "border",
		"$value": {
			"color": "{fontColor}",
			"style": "solid",
			"width": { "value": 0.125, "unit": "rem" }
		}
	},
	"shadow": {
		"$type": "shadow"
	},
	"typography": {
		"$type": "typography",
		"$value": {
			"fontFamily": "{fontFamily}",
			"fontSize": "{fontSize}",
			"fontWeight": 300,
			"letterSpacing": "{letterSpacing}",
			"lineHeight": "{lineHeight}"
		}
	},
	"headingTypography": {
		"$type": "typography",
		"$value": {
			"fontFamily": "{fontFamily}",
			"fontWeight": 600,
			"letterSpacing": "{letterSpacing}",
			"lineHeight": "{lineHeight}"
		}
	},

	"button": {
		"color": {
			"$type": "color",
			"$value": "{color}"
		},
		"radius": {
			"$type": "dimension",
			"$value": { "value": 0, "unit": "" }
		}
	},
	"a": {
		"color": {
			"$type": "color",
			"$value": "{color}"
		}
	},
	"h1": {
		"fontSize": {
			"$type": "fontSize",
			"$value": { "value": 200, "unit": "%" }
		}
	},
	"lightness": {
		"$description": "variables to set color final value"
	}
}
