{
	"name": "@willfarrell-ds/svelte",
	"version": "0.0.0-beta.1",
	"type": "module",
	"description": "Design system using Svelte",
	"files": [
		"components/",
		"elements/",
		"hooks/",
		"utils/",
		"!**/*.test.js",
		"!**/*.test.svelte",
		"!**/.DS_Store"
	],
	"exports": {
		"./components/*": "./components/*",
		"./elements/*": "./elements/*",
		"./hooks/*": "./hooks/*",
		"./utils/*": "./utils/*"
	},
	"scripts": {
		"test": "node --test --experimental-test-module-mocks '**/*.test.js'"
	},
	"repository": {
		"type": "git",
		"url": "git+https://willfarrell@github.com/willfarrell/design-system.git"
	},
	"author": "willfarrell",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/willfarrell/design-system/issues"
	},
	"homepage": "https://github.com/willfarrell/design-system#readme",
	"dependencies": {
		"@willfarrell-ds/vanilla": "0.0.0-beta.1",
		"html-minifier-terser": "7.2.0",
		"pretty": "2.0.0"
	},
	"peerDependencies": {
		"@sveltejs/kit": "^3.0.0",
		"svelte": "^5.57.1",
		"vite": "^8.3.2"
	}
}
