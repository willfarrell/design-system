{
	"kit": {
		"csp": {
			"mode": "hash",
			"directives": {
				"default-src": ["none"],
				"base-uri": ["none"],
				"connect-src": ["self"],
				"form-action": ["self"],
				"frame-ancestors": ["self"],
				"frame-src": ["self"],
				"img-src": ["self"],
				"manifest-src": ["self"],
				"require-trusted-types-for": ["script"],
				"script-src": ["self"],
				"script-src-attr": ["report-sample"],
				"style-src": ["self"],
				"style-src-attr": ["report-sample"],
				"trusted-types": ["svelte-trusted-html"],
