{
	"name": "design-system.willfarrell.ca",
	"version": "0.0.0-alpha.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "vite dev",
		"build": "npm run build:scripts && npm run build:svelte && npm run build:styles:extract && npm run build:styles:optimize && npm run build:svg",
		"build:scripts": "npm run build:scripts:bootstrap && npm run build:scripts:components",
		"build:scripts:bootstrap": "esbuild src/scripts/* --platform=browser --format=esm  --bundle --minify '--external:/js/*' --legal-comments=external --sourcemap=external --log-level=error --allow-overwrite --outdir=static/js/",
		"build:scripts:components": "rm -rf static/js/pewc && mkdir -p static/js/pewc && cp ../../packages/vanilla/components/ds-*.js static/js/pewc/ && esbuild static/js/pewc/* --platform=browser --format=esm  --bundle --minify '--external:/js/*' --legal-comments=external --sourcemap=external --log-level=error --allow-overwrite --outdir=static/js/pewc/",
		"build:styles:extract": "node ../../packages/cli/index.js extract --input-dir ./.svelte-kit --input-dir ./build --theme ./src/styles/theme.css --output-dir src/styles/",
		"build:styles:optimize": "node ../../packages/cli/index.js optimize-styles ./.svelte-kit",
		"build:svelte": "vite build",
		"build:svg": "npx svgo --multipass --recursive ./.svelte-kit/ -o ./.svelte-kit/",
		"preview": "vite preview",
		"test": "npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:e2e:dev": "playwright test --ui",
		"test:e2e:new": "playwright codegen https://localhost:5173",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"release:login": "wrangler login --browser false",
		"release:deploy": "wrangler deploy"
	},
	"dependencies": {
		"@willfarrell-ds/svelte": "0.0.0-alpha.0",
		"@willfarrell-ds/vanilla": "0.0.0-alpha.0",
		"apca-w3": "^0.1.0",
		"change-case": "5.4.4",
		"chroma-js": "^3.0.0",
		"colorparsley": "^0.1.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.11.1",
		"@playwright/test": "1.58.2",
		"@sveltejs/adapter-cloudflare": "^7.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@willfarrell-ds/cli": "0.0.0-alpha.0",
		"postcss": "^8.0.0",
		"postcss-calc": "^10.0.0",
		"postcss-cli": "^11.0.0",
		"postcss-csso": "^6.0.0",
		"postcss-extract-media-query": "^3.0.0",
		"postcss-import": "^16.0.0",
		"postcss-nesting": "^14.0.0",
		"svelte": "^5.0.0",
		"svelte-preprocess": "^6.0.0",
		"svgo": "^4.0.0",
		"vite": "^7.0.0",
		"vite-plugin-llms": "^1.0.0",
		"vite-plugin-mkcert": "^1.0.0",
		"vite-plugin-sitemap": "^0.8.0",
		"vite-plugin-sri": "^0.0.2",
		"wrangler": "^4.0.0"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "0.7.2"
		}
	}
}
