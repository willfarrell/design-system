{
	"name": "design-system.willfarrell.ca",
	"version": "0.0.0-alpha.8",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "vite dev",
		"build": "npm run build:svelte && npm run build:workers && npm run build:styles:extract && npm run build:styles:optimize && npm run build:svg",
		"build:workers": "cp -R .svelte-kit/output/server/_/immutable/workers .svelte-kit/cloudflare/_/immutable/workers && cp -R .svelte-kit/output/server/_/immutable/workers .svelte-kit/output/client/_/immutable/workers",
		"build:styles:extract": "node ../../packages/cli/index.js extract --input-dir ./.svelte-kit --theme ./src/styles/theme.css --output-dir src/styles/",
		"build:styles:optimize": "node ../../packages/cli/index.js optimize-styles ./.svelte-kit",
		"build:svelte": "vite build",
		"build:svg": "npx svgo --multipass --recursive ./.svelte-kit/ -o ./.svelte-kit/",
		"preview": "vite preview",
		"test": "npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:e2e:dev": "playwright test --ui",
		"test:e2e:new": "playwright codegen https://localhost:5173",
		"release:login": "wrangler login --browser false",
		"release:deploy": "wrangler deploy"
	},
	"dependencies": {
		"@willfarrell-ds/svelte": "0.0.0-alpha.8",
		"@willfarrell-ds/vanilla": "0.0.0-alpha.8",
		"@work-bee/core": "0.4.0",
		"@work-bee/fallback": "0.0.5",
		"@work-bee/offline": "0.4.0",
		"@work-bee/save-data": "0.4.0",
		"apca-w3": "^0.1.9",
		"change-case": "5.4.4",
		"chroma-js": "^3.2.0",
		"colorparsley": "^0.1.8"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.69.2",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@willfarrell-ds/cli": "0.0.0-alpha.8",
		"svelte": "^5.56.4",
		"svgo": "^4.0.1",
		"vite": "^8.1.4",
		"vite-plugin-llms": "^1.0.2",
		"vite-plugin-mkcert": "^2.1.0",
		"vite-plugin-sitemap": "^0.8.2",
		"vite-plugin-sri": "^0.0.2",
		"wrangler": "^4.110.0"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": ">=0.7.2"
		}
	}
}
