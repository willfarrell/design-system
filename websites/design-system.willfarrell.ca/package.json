{
	"name": "website",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"start": "vite dev",
		"build": "npm run build:scripts && npm run build:svelte && npm run build:styles && npm run build:svelte",
		"build:styles": "npm run build:styles:ds && npm run build:styles:postcss",
		"build:styles:ds": "npx ds extract build --css-path src/styles/app.css --theme ./theme.css --debug",
		"build:styles:postcss": "postcss src/styles/*.css -d static/css/ --no-map",
		"build:styles:copy": "cp static/css/* build/css/",
		"build:styles:inline": "npx ds inline build/css/app.css build --debug",
		"build:scripts": "npm run build:scripts:bootstrap && npm run build:scripts:components",
		"build:scripts:bootstrap": "esbuild src/scripts/* --platform=browser --format=esm  --bundle --minify '--external:/js/*' --legal-comments=external --sourcemap=external --log-level=error --allow-overwrite --outdir=static/js/",
		"build:scripts:components": "rm -rf static/js/pewc && mkdir -p static/js/pewc && cp ../packages/component/ds-*.js static/js/pewc/ && esbuild static/js/pewc/* --platform=browser --format=esm  --bundle --minify '--external:/js/*' --legal-comments=external --sourcemap=external --log-level=error --allow-overwrite --outdir=static/js/pewc/",
		"build:svelte": "vite build",
		"preview": "vite preview",
		"test": "npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:update": "playwright test --update-snapshots",
		"test:e2e:dev": "playwright test --ui",
		"test:e2e:new": "playwright codegen https://localhost:5173",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"release:login": "wrangler login --browser false",
		"releases:domain": "curl https://api.cloudflare.com/client/v4/accounts/${ACCOUNT_ID}/pages/projects/middy/domains -H 'Content-Type: application/json' -H 'Authorization: Bearer ${API_KEY_W_PAGES_EDIT}' -d '{\"name\": \"middy.js.org\"}'",
		"release:deploy:workers": "wrangler deploy --config wrangler.worker.jsonc",
		"release:deploy:pages": "wrangler pages deploy"
	},
	"dependencies": {
		"@design-system/component": "file:../packages/component",
		"@design-system/core": "file:../packages/core",
		"@design-system/style": "file:../packages/style",
		"@design-system/svelte": "file:../packages/svelte",
		"change-case": "5.4.4"
	},
	"devDependencies": {
		"@design-system/cli": "file:../packages/cli",
		"@sveltejs/adapter-cloudflare": "^7.0.0",
		"@sveltejs/kit": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"postcss": "^8.0.0",
		"postcss-calc": "^10.0.0",
		"postcss-cli": "^11.0.0",
		"postcss-csso": "^6.0.0",
		"postcss-extract-media-query": "^3.0.0",
		"postcss-import": "^16.0.0",
		"postcss-nesting": "^13.0.0",
		"svelte": "^5.0.0",
		"svelte-preprocess": "^6.0.0",
		"vite": "^6.0.0",
		"vite-plugin-llms": "^1.0.0",
		"vite-plugin-mkcert": "^1.0.0",
		"vite-plugin-sitemap": "^0.8.0",
		"vite-plugin-sri": "^0.0.2",
		"wrangler": "^4.0.0"
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "0.7.2"
		}
	}
}
